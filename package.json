  "type": "module",
  "main": "dist/index.js",
  "description": "Telnyx embedding provider for OpenClaw memory search",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": "2026.4"
    },
    "build": {
